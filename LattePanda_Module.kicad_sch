	(text "Sleeping State Signal\n\n- SLS_S0: \n  - S0 (Working): HIGH\n  - S3 (Slpeeping): LOW\n  - S4 (Hibernation): LOW\n  - S5 (Soft Off): LOW\n- SLS_S3:\n  - S0 (Working): HIGH\n  - S3 (Slpeeping): HIGH\n  - S4 (Hibernation): LOW\n  - S5 (Soft Off): LOW"
		(exclude_from_sim no)
		(at 157.226 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1c7e9aa8-4f83-40b7-83bd-521dbfb5241b")
	)
	(text "DDI/TCP functions are defined by the BIOS source code. \nCannot be changed in BIOS settings.\n\nBefore starting design, you should choose one of\nthe available BIOS configurations on:\nhttps://github.com/LattePandaTeam/LattePanda-Mu\n\nThe default functions are defined as follows:\n\n- DDIA: eDP 1.4b (the 40Pin connector on the Mu)\n\n- DDIB: HDMI 2.0\n\n- TCP0: HDMI 2.0\n\n- TCP1: USB TypeC (need external PD controller)"
		(exclude_from_sim no)
		(at 79.248 228.346 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "21818b02-1daa-4eb7-9e89-230be6ac534c")
	)
	(text "HSIO functions are defined by the BIOS source code, \nCannot be changed in BIOS settings.\n\nBefore starting design, you should choose one of\nthe available BIOS configurations on:\nhttps://github.com/LattePandaTeam/LattePanda-Mu\n\nThe default functions are defined as follows:\n\n- HSIO0: USB3.2 10Gbps\n- HSIO1: USB3.2 10Gbps\n- HSIO2: PCIe 3.0 x1\n- HSIO3: PCIe 3.0 x1\n\n- HSIO8: PCIe 3.0 x4 (Lane 0)\n- HSIO9: PCIe 3.0 x4 (Lane 1)\n- HSIO10: PCIe 3.0 x4 (Lane 2)\n- HSIO11: PCIe 3.0 x4 (Lane 3)\n\n- HSIO6: PCIe 3.0 x1"
		(exclude_from_sim no)
		(at 79.248 101.346 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4b3c26b0-f9f7-4098-9bcf-3a0141ebd3a4")
	)
	(text "SPI is only used to connect to the BIOS ROM and discrete TPM\nCannot be used as a general SPI interface."
		(exclude_from_sim no)
		(at 396.494 259.334 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "56ace587-4c57-48fa-bd9c-b2d4606751a2")
	)
	(text "Lite Carrier has no second BIOS ROM\n~{BIOS_SEL} pull up to 3.3V to select ROM on LattePanda Mu"
		(exclude_from_sim no)
		(at 395.986 275.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5b136086-b7bb-414a-bab1-28be0c658ddb")
	)
	(text "HPD pin of unused DDI/TCP port\nneeds to be pulled down"
		(exclude_from_sim no)
		(at 254 264.922 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right top)
		)
		(uuid "913a81e0-0147-43f1-8669-3710e0dcda26")
	)
	(text "~{CLKREQ} is reserved for PCIe ASPM L1s\nUnless the device clearly supports it, pull it down to enhance compatibility"
		(exclude_from_sim no)
		(at 380.492 124.714 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "96998949-cd7e-4ffe-aca1-0672957379b2")
	)
	(text "USB2_P6 is reserved for TypeC PD Controller\nDO NOT use it as a normal USB"
		(exclude_from_sim no)
		(at 369.316 147.828 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
